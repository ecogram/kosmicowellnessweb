{
  "name": "sweet-monk-store",
  "version": "1.0.0",
  "description": "Kosmiko Wellness D2C E-Commerce",
  "workspaces": [
    "frontend",
    "backend",
    "worker"
  ],
  "scripts": {
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "worker": "npm run worker:dev --prefix backend",
    "dev": "docker-compose -f docker-compose.dev.yml up",
    "build": "npm run build --prefix frontend && node -e \"require('fs').cpSync('frontend/dist', 'dist', {recursive: true})\"",
    "lint": "npx eslint .",
    "format": "npx prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.3"
  }
}
