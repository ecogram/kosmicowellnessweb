# ── Server Configuration ────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/sweet-monk

# ── JWT Authentication ──────────────────────────────────
JWT_ACCESS_SECRET=supersecretaccess_change_in_production
JWT_REFRESH_SECRET=supersecretrefresh_change_in_production
JWT_ACCESS_EXPIRES_IN=15m

# ── Redis / BullMQ ──────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PASSWORD=

# ── Client URL (CORS) ───────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Cloudinary (Image Uploads) ──────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (SMTP / Nodemailer) ───────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ── Razorpay Payment Gateway ────────────────────────────
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret
